# LoveBack — miljövariabler
#
# DEMOLÄGE (npm run demo) behöver INGEN .env-fil. Hoppa över den här filen
# om du bara ska visa demon.
#
# För att köra appen mot den riktiga backend:en: kopiera filen till ".env"
# och fyll i värdena från Supabase → Project Settings → API.
# Checka aldrig in .env i Git. Lägg aldrig service_role-nyckeln här —
# endast den publika anon-nyckeln hör hemma i appen.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
